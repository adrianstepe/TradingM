# Telegram bot token from @BotFather
BOT_TOKEN=

# Your numeric Telegram user id (from @userinfobot). Only this user can
# talk to the bot — everyone else is ignored.
OWNER_ID=

# A long random passphrase used to encrypt wallet private keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this = losing access to every stored wallet. Keep it out of git.
MASTER_PASSWORD=

# Solana RPC endpoint. The public one is rate-limited; a dedicated RPC
# (Helius, QuickNode, Triton, etc.) is strongly recommended for real trading.
RPC_URL=https://api.mainnet-beta.solana.com

# Slippage caps in basis points (100 = 1%). Jupiter's dynamic slippage picks
# the actual value used at swap time based on live liquidity, up to this cap
# — it will not always spend the full allowance. Sells can reasonably run
# higher than buys since a panic exit needs to land even at a worse price;
# either number directly bounds how much value a sandwich bot could extract
# from a single trade, so keep them as low as you can tolerate.
BUY_SLIPPAGE_BPS=2500
SELL_SLIPPAGE_BPS=4200

# Optional. Ceiling on the priority fee attached to a single swap, in lamports
# (1 SOL = 1,000,000,000). Higher lands faster when Solana is congested.
MAX_PRIORITY_FEE_LAMPORTS=2000000

# Optional. A paid Jupiter API key routes to api.jup.ag with higher rate
# limits; leave blank to use the free lite-api.jup.ag tier.
JUPITER_API_KEY=
